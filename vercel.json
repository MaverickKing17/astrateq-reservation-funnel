{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ais-pre-s6u7jrrldvcs37we67vooo-17591009632.us-east1.run.app/api/:path*"
